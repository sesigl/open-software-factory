{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "include-component-in-tag": true,
  "packages": {
    "contracts": {
      "release-type": "node",
      "package-name": "@opensoftware/contracts",
      "component": "contracts",
      "extra-files": [
        {
          "type": "json",
          "path": "openapi/openapi.json",
          "jsonpath": "$.info.version"
        }
      ]
    },
    "packages/testkit": {
      "release-type": "node",
      "package-name": "@opensoftware/testkit",
      "component": "testkit",
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true
    },
    "modules/factory-spec": {
      "release-type": "node",
      "package-name": "@opensoftware/factory-spec",
      "component": "factory-spec",
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true
    },
    "modules/runlog": {
      "release-type": "node",
      "package-name": "@opensoftware/runlog",
      "component": "runlog",
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true
    }
  }
}
