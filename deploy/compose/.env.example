# Copy this file to .env and set every value. Never commit .env.
POSTGRES_PASSWORD=
LITELLM_MASTER_KEY=sk-
FOREMAN_API_TOKEN=
INTAKE_API_TOKEN=
GATEKEEPER_API_TOKEN=
# The secret store OpenBao (ADR 0145); osf init generates these four, 64 hex digits each. The unseal key opens the
# volume openbao at every start: back it up with the volume, and never change it for a volume that holds data.
OSF_OPENBAO_UNSEAL_KEY=
# The root token, which only openbao and its job openbao-setup get.
OSF_OPENBAO_ROOT_TOKEN=
# The console's token, which stores and deletes values and cannot read one, and the egress proxy's, which only reads.
OSF_OPENBAO_CONSOLE_TOKEN=
OSF_OPENBAO_EGRESS_TOKEN=
# Optional. The KV version 2 mount of the factory's secrets. Default: secret.
OSF_OPENBAO_MOUNT=
# gatekeeper asks in Slack, on pull requests, or both: set the three Slack values, GATEKEEPER_FORGE_TOKEN, or all.
GATEKEEPER_SLACK_CHANNEL=
GATEKEEPER_SLACK_TOKEN=
GATEKEEPER_SLACK_SIGNING_SECRET=
# A token that may comment on the pull requests and set their commit status, for gates on pull requests.
GATEKEEPER_FORGE_TOKEN=
# Optional. The forge's API where gatekeeper asks on pull requests, like https://ghe.example/api/v3. Default: GitHub's
# API. A request's pull request link counts only on this forge, and gatekeeper calls no other host with the token.
GATEKEEPER_FORGE_URL=
# The seed of gatekeeper's Ed25519 key, 64 hex digits; osf init generates it. gatekeeper signs each approval record
# with it, and does not start without it.
GATEKEEPER_SIGNING_KEY=
# Optional. The secret of the forge's issues webhook to intake's /forge/events. Empty: intake takes no forge webhooks.
INTAKE_WEBHOOK_SECRET=
# Optional. A token that may read pull requests and their checks, for stages with checks.
FOREMAN_FORGE_TOKEN=
# Optional. A token of `claude setup-token`: Claude Code runs on your subscription, through litellm.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional. A token with which the agents clone, push and open pull requests on github.com.
GH_TOKEN=
# Optional. The folder of your factory, relative to this folder. Default: ./factory, the reference factory.
FACTORY_DIR=
# Optional. Your factory's repository on a forge in place of FACTORY_DIR, as git+<url>#<branch>, like
# git+https://github.com/acme/factory.git#main (ADR 0150): factory-repo clones it at each start, foreman fetches it at
# each run, and the console proposes each change of the factory as a pull request on it. See deploy/README.md.
FACTORY_REPOSITORY=
# With FACTORY_REPOSITORY: a forge token of that repository only, which clones and fetches it and opens, merges and
# closes the console's pull requests. Not GH_TOKEN of the agents.
FACTORY_TOKEN=
# With FACTORY_REPOSITORY: the user of FACTORY_TOKEN as the forge adapter names an author, like github:acme-factory.
FACTORY_USER=
# With FACTORY_REPOSITORY on Forgejo: forge-forgejo and the forge's URL, like https://codeberg.org. Default:
# forge-github and GitHub's API.
FACTORY_FORGE_ADAPTER=
FACTORY_FORGE_URL=
# Optional. The host's Docker socket for docker-proxy, the foreman's way to the agents' sandboxes. Default:
# /var/run/docker.sock.
DOCKER_SOCKET=
# Optional. How many stages run an agent at once, each in its own sandbox; the others wait for a place (ADR 0160).
# Default: 2.
FOREMAN_MAX_STAGES=
# Optional, for docker compose --profile improve. Seconds between the runs of the improvement jobs; 0 runs
# them once. Default: 3600.
IMPROVE_INTERVAL=
# Optional. The scorers that judge each run, like "redundant-tests scope-creep". Each judgment is a paid model call
# through litellm. Empty: no scoring.
IMPROVE_SCORERS=
# Optional. The console's own sign-in: oidc (Google, a company's provider) or github. Empty: the console is open and
# read-only. Set, only the people of the factory's access.yaml sign in, with the settings of that provider below.
CONSOLE_SIGN_IN=
# The key of the console's session cookie; osf init generates it.
CONSOLE_SESSION_SECRET=
# The seed of the console's Ed25519 key, 64 hex digits; osf init generates it. The console signs with it the proof of
# the person on each action, and with the sign-in on foreman, intake and gatekeeper check that proof (ADR 0151). To
# change it, set "old,new", after 10 minutes "new,old", and a minute later "new".
CONSOLE_SIGNING_KEY=
# With oidc: the provider's issuer, like https://accounts.google.com, and the client's ID and secret.
CONSOLE_OIDC_ISSUER=
CONSOLE_OIDC_CLIENT_ID=
CONSOLE_OIDC_CLIENT_SECRET=
# With github: the client ID and secret of a GitHub OAuth app.
CONSOLE_GITHUB_CLIENT_ID=
CONSOLE_GITHUB_CLIENT_SECRET=
# Optional. Where people open the console; the provider's callback is <CONSOLE_URL>/signin/callback. It must be
# https:// or loopback. Default: http://localhost:<CONSOLE_PORT>, http://localhost:8080.
CONSOLE_URL=
