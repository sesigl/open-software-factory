# Copy this file to .env and set every value. Never commit .env.
POSTGRES_PASSWORD=
LITELLM_MASTER_KEY=sk-
FOREMAN_API_TOKEN=
INTAKE_API_TOKEN=
GATEKEEPER_API_TOKEN=
# gatekeeper asks in Slack, on pull requests, or both: set the three Slack values, GATEKEEPER_FORGE_TOKEN, or all.
GATEKEEPER_SLACK_CHANNEL=
GATEKEEPER_SLACK_TOKEN=
GATEKEEPER_SLACK_SIGNING_SECRET=
# A token that may comment on the pull requests and set their commit status, for gates on pull requests.
GATEKEEPER_FORGE_TOKEN=
# Optional. The secret of the forge's issues webhook to intake's /forge/events. Empty: intake takes no forge webhooks.
INTAKE_WEBHOOK_SECRET=
# Optional. A token that may read pull requests and their checks, for stages with checks.
FOREMAN_FORGE_TOKEN=
# Optional. A token of `claude setup-token`: Claude Code runs on your subscription, through litellm.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional. A token with which the agents clone, push and open pull requests on github.com.
GH_TOKEN=
# Optional. The folder of your factory, relative to this folder. Default: ./factory, the reference factory.
FACTORY_DIR=
