{
  "name": "@opensoftware/secrets-openbao",
  "version": "0.0.0",
  "description": "secrets-openbao: stores, lists and deletes the values of the factory's secrets in OpenBao without ever printing one, behind the factory's secrets port.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sesigl/open-software-factory.git",
    "directory": "adapters/secrets/openbao"
  },
  "type": "module",
  "bin": {
    "secrets-openbao": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:system": "testkit timed vitest run",
    "docs": "node ../../../tools/bin/osf.ts docs .",
    "mutation": "node ../../../tools/bin/osf.ts mutation ."
  },
  "devDependencies": {
    "@opensoftware/testkit": "workspace:*"
  },
  "dependencies": {
    "@opensoftware/cli": "workspace:*"
  }
}
