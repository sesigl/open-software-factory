{
  "name": "@opensoftware/inference-litellm",
  "version": "0.1.0",
  "description": "inference-litellm: one OpenAI-compatible model endpoint for every harness, with routing aliases, budgets per run and a spend log, run as LiteLLM with PostgreSQL on Docker.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sesigl/open-software-factory.git",
    "directory": "adapters/inference/litellm"
  },
  "type": "module",
  "bin": {
    "inference-litellm": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:system": "vitest run",
    "docs": "node ../../../tools/bin/osf.ts docs .",
    "mutation": "node ../../../tools/bin/osf.ts mutation ."
  },
  "devDependencies": {
    "@opensoftware/testkit": "workspace:*"
  },
  "dependencies": {
    "@opensoftware/cli": "workspace:*",
    "yaml": "2.9.1"
  }
}
