{
  "name": "@opensoftware/channel-slack",
  "version": "0.0.0",
  "description": "channel-slack: Slack mentions as work items, replies and approval cards with buttons, behind the factory's channel port, on Vercel Chat SDK.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sesigl/open-software-factory.git",
    "directory": "adapters/channel/slack"
  },
  "type": "module",
  "bin": {
    "channel-slack": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:system": "vitest run",
    "docs": "node ../../../tools/bin/osf.ts docs .",
    "mutation": "node ../../../tools/bin/osf.ts mutation ."
  },
  "devDependencies": {
    "@opensoftware/contracts": "workspace:*",
    "@opensoftware/testkit": "workspace:*"
  },
  "dependencies": {
    "@chat-adapter/slack": "4.43.0",
    "@chat-adapter/state-memory": "4.43.0",
    "@opensoftware/cli": "workspace:*",
    "chat": "4.43.0"
  }
}
