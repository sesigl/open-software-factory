{
  "name": "@opensoftware/forge-forgejo",
  "version": "0.5.0",
  "description": "forge-forgejo: branches, pull requests, checks, comments, merge rules, webhooks and pull request events on Forgejo, behind the factory's forge port.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sesigl/open-software-factory.git",
    "directory": "adapters/forge/forgejo"
  },
  "type": "module",
  "bin": {
    "forge-forgejo": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:system": "vitest run",
    "docs": "node ../../../tools/bin/osf.ts docs .",
    "mutation": "node ../../../tools/bin/osf.ts mutation ."
  },
  "osf": {
    "mutationLinesPerShard": 25
  },
  "devDependencies": {
    "@opensoftware/contracts": "workspace:*",
    "@opensoftware/testkit": "workspace:*"
  },
  "dependencies": {
    "@opensoftware/cli": "workspace:*"
  }
}
