{
  "name": "@opensoftware/factory-spec",
  "version": "0.2.0",
  "description": "factory-spec: one factory.yaml rendered for every harness, with lint, plan, apply and drift.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sesigl/open-software-factory.git",
    "directory": "modules/factory-spec"
  },
  "type": "module",
  "bin": {
    "factory": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:system": "vitest run",
    "docs": "node ../../tools/bin/osf.ts docs .",
    "mutation": "node ../../tools/bin/osf.ts mutation ."
  },
  "dependencies": {
    "@opensoftware/contracts": "workspace:*",
    "semver": "7.7.3",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@opensoftware/testkit": "workspace:*",
    "@types/semver": "7.7.1"
  }
}
