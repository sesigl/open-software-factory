{
  "name": "@opensoftware/factory-spec",
  "version": "0.0.0",
  "private": true,
  "description": "factory-spec: one factory.yaml rendered for every harness, with lint, plan, apply and drift.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "factory": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:system": "vitest run",
    "docs": "node ../../tools/bin/osf.ts docs ."
  },
  "dependencies": {
    "@opensoftware/contracts": "workspace:*",
    "semver": "7.7.3",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@opensoftware/testkit": "workspace:*",
    "@types/semver": "7.7.1"
  }
}
