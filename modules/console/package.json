{
  "name": "@opensoftware/console",
  "version": "0.12.0",
  "description": "console: the web UI of a factory, where the people on its access list follow its runs and act on them.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sesigl/open-software-factory.git",
    "directory": "modules/console"
  },
  "type": "module",
  "bin": {
    "console": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && astro build",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && astro-check --root . --tsconfig tsconfig.astro.json",
    "test:system": "testkit timed vitest run",
    "docs": "node ../../tools/bin/osf.ts docs .",
    "mutation": "node ../../tools/bin/osf.ts mutation ."
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@opensoftware/forge-forgejo": "workspace:*",
    "@opensoftware/forge-github": "workspace:*",
    "@opensoftware/secrets-openbao": "workspace:*",
    "@opensoftware/testkit": "workspace:*",
    "@opensoftware/ui": "workspace:*",
    "solid-js": "1.9.18",
    "typescript": "5.9.3",
    "vite-plugin-solid": "2.11.15"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@opensoftware/cli": "workspace:*",
    "@opensoftware/contracts": "workspace:*",
    "@opensoftware/factory-source": "workspace:*",
    "@opensoftware/person-proof": "workspace:*",
    "astro": "7.4.4",
    "fastify": "5.12.7",
    "jose": "6.2.17",
    "markdown-it": "15.0.3",
    "openid-client": "6.9.0",
    "yaml": "2.9.1"
  }
}
