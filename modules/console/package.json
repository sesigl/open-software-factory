{
  "name": "@opensoftware/console",
  "version": "0.6.0",
  "description": "console: a read-only web view of a factory: its runs with their origin and evidence, and its configuration with links to Git.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sesigl/open-software-factory.git",
    "directory": "modules/console"
  },
  "type": "module",
  "bin": {
    "console": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && astro build",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && astro-check --root . --tsconfig tsconfig.astro.json",
    "test:system": "testkit timed vitest run",
    "docs": "node ../../tools/bin/osf.ts docs .",
    "mutation": "node ../../tools/bin/osf.ts mutation ."
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@opensoftware/forge-github": "workspace:*",
    "@opensoftware/testkit": "workspace:*",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@opensoftware/cli": "workspace:*",
    "@opensoftware/contracts": "workspace:*",
    "@picocss/pico": "2.1.1",
    "astro": "7.4.4",
    "fastify": "5.12.7",
    "htm": "3.1.1",
    "preact": "11.0.1",
    "preact-render-to-string": "6.8.0",
    "yaml": "2.9.1"
  }
}
