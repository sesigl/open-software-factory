---
import Shell from "@opensoftware/ui/components/Shell.astro";
import type { RunsData } from "../../pages/runs.ts";

const { shell, filters, notes, rows, empty, work, next } = Astro.locals.page as RunsData;
Astro.response.status = Astro.locals.status;
Astro.response.statusText = Astro.locals.statusText;
---
<Shell shell={shell}>
  <div class="osf-heading">
    <h1>Runs</h1>
    {work && <div class="osf-dock"><a class="osf-action" href="/work">Submit work</a></div>}
  </div>
  <nav aria-label="States">
    <ul class="osf-tabs">
      {filters.map((filter) => <li><a href={filter.href} aria-current={filter.current}>{filter.name}</a></li>)}
    </ul>
  </nav>
  {notes.map((note) => <p role="alert" class="osf-alert">{note}</p>)}
  {empty && <p class="osf-empty">No runs yet. A run starts when the factory takes a piece of work.</p>}
  <div class="osf-table-panel">
    <table class="osf-table osf-cards">
      <thead>
        <tr>
          <th scope="col">Run</th>
          <th scope="col">Factory</th>
          <th scope="col">State</th>
          <th scope="col">Source</th>
          <th scope="col">Requester</th>
          <th scope="col">Pull request</th>
          <th scope="col">Age</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((run) => (
          <tr class={run.rowClass}>
            <td class="osf-card-title"><a href={run.href}>{run.title}</a></td>
            <td class="osf-mono">{run.factory}</td>
            <td class="osf-card-state"><span class={run.stateClass}>{run.state}</span></td>
            <td>{run.source}</td>
            <td>{run.requester}</td>
            <td>{run.pullRequest.href ? <a class="osf-mono" href={run.pullRequest.href}>{run.pullRequest.text}</a> : run.pullRequest.text}</td>
            <td class="osf-mono osf-card-corner">{run.age}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {next && <p><a href={next} rel="next">Next page</a></p>}
</Shell>
