---
import Shell from "@opensoftware/ui/components/Shell.astro";
import WorkList from "@opensoftware/ui/components/WorkList.astro";
import type { WorkData } from "../../pages/work.ts";

const { shell, notes, list, form, next } = Astro.locals.page as WorkData;
Astro.response.status = Astro.locals.status;
Astro.response.statusText = Astro.locals.statusText;
---
<Shell shell={shell}>
  <div class="osf-intro">
    <h1>Work</h1>
    <p>The latest work items, the one received last first.</p>
  </div>
  {notes.map((note) => <p role="alert" class="osf-alert">{note}</p>)}
  <div class="osf-split">
    {form && (
      <form class="osf-panel osf-split-side" method="post" action="/work" aria-labelledby="submit">
        <h2 id="submit">Submit work</h2>
        <div class="osf-field">
          <label for="work-title">Title</label>
          <input id="work-title" class="osf-input" name="title" type="text" required maxlength="300" autocomplete="off" />
        </div>
        <div class="osf-field">
          <label for="work-type">Type</label>
          <select id="work-type" class="osf-input" name="type">
            <option value="task">task</option>
            <option value="bug">bug</option>
            <option value="idea">idea</option>
            <option value="automation">automation</option>
          </select>
        </div>
        <div class="osf-field">
          <label for="work-description">Description</label>
          <textarea id="work-description" class="osf-input" name="description"></textarea>
        </div>
        <div class="osf-buttons">
          <button type="submit" class="osf-action">Submit</button>
        </div>
        <p class="osf-footnote">Intake takes it as work from the console, with you as the person who asked.</p>
      </form>
    )}
    <div class="osf-split-main">
      <WorkList list={list} />
      {next && <p><a href={next} rel="next">Next page</a></p>}
    </div>
  </div>
</Shell>
