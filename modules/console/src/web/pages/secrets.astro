---
import Shell from "@opensoftware/ui/components/Shell.astro";
import type { SecretsData } from "../../pages/secrets.ts";

const { shell, notes, rows, empty, form } = Astro.locals.page as SecretsData;
Astro.response.status = Astro.locals.status;
Astro.response.statusText = Astro.locals.statusText;
---
<Shell shell={shell}>
  <div class="osf-intro">
    <h1>Secrets</h1>
    <p>
      You store values here. Which agent may use a secret is decided in the factory definition. An agent never holds
      a value: its sandbox's egress proxy adds it on the way out, only to the hosts the agent may reach.
    </p>
    <p>
      The egress proxy reads a value at the first request that needs it and keeps it while its sandbox runs, so a new
      value counts from the next sandbox that starts, like the next run's. A secret that is not sent in an HTTP
      request, like an SSH key or a database password, does not work this way.
    </p>
  </div>
  {notes.map((note) => <p role="alert" class="osf-alert">{note}</p>)}
  <div class="osf-split">
    <div class="osf-split-main">
      {empty ? (
        <p class="osf-empty">No secrets yet. An agent declares one in the factory definition, like ref:openbao/linear-token.</p>
      ) : (
        <ul class="osf-list" aria-label="Secrets">
          {rows.map((row) => (
            <li class={row.rowClass}>
              <div class="osf-list-text">
                <span class="osf-mono osf-strong">{row.name}</span>
                <span class="osf-secondary">{row.detail}</span>
              </div>
              <div class="osf-list-end">
                <span class={row.stateClass}>{row.state}</span>
                {row.action && (
                  <a class="osf-secondary" href={row.action.href}>{row.action.text}<span class="osf-hidden"> {row.name}</span></a>
                )}
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>
    <form class="osf-panel osf-split-side" method="post" action="/secrets" aria-labelledby="store">
      <h2 id="store">Store a value</h2>
      <div class="osf-field">
        <label for="secret-name">Name</label>
        <input id="secret-name" class="osf-input osf-mono" name="name" type="text" value={form.name} required autocomplete="off" spellcheck="false" />
      </div>
      <div class="osf-field">
        <label for="secret-value">Value</label>
        <input id="secret-value" class="osf-input osf-mono" name="value" type="password" required autocomplete="off" aria-describedby="secret-value-hint" />
        <p id="secret-value-hint" class="osf-hint">Nobody can read it again here, you included. To change it, store a new value.</p>
      </div>
      <div class="osf-buttons">
        <button type="submit" class="osf-action">Store value</button>
        <a class="osf-button" href="/secrets">Cancel</a>
      </div>
      <p class="osf-footnote">Takes effect in the next sandbox that starts. {form.reach}</p>
    </form>
  </div>
</Shell>
