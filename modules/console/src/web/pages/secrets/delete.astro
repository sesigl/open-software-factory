---
import Shell from "@opensoftware/ui/components/Shell.astro";
import type { DeleteData } from "../../../pages/secrets.ts";

const { shell, title, name, effect } = Astro.locals.page as DeleteData;
Astro.response.status = Astro.locals.status;
Astro.response.statusText = Astro.locals.statusText;
---
<Shell shell={shell}>
  <div class="osf-intro">
    <h1>{title}</h1>
    <p>{effect}</p>
  </div>
  <form class="osf-buttons" method="post" action="/secrets/delete">
    <input type="hidden" name="name" value={name} />
    <button type="submit" class="osf-action">Delete</button>
    <a class="osf-button" href="/secrets">Cancel</a>
  </form>
</Shell>
