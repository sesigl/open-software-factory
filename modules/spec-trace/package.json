{
  "name": "@opensoftware/spec-trace",
  "version": "0.3.0",
  "description": "spec-trace: every Gherkin scenario traced to its one test and its result, as a check and a JSON report.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sesigl/open-software-factory.git",
    "directory": "modules/spec-trace"
  },
  "type": "module",
  "bin": {
    "spec-trace": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:system": "vitest run",
    "docs": "node ../../tools/bin/osf.ts docs .",
    "mutation": "node ../../tools/bin/osf.ts mutation ."
  },
  "devDependencies": {
    "@opensoftware/testkit": "workspace:*",
    "@types/picomatch": "4.0.3"
  },
  "dependencies": {
    "@opensoftware/contracts": "workspace:*",
    "@opensoftware/spec-files": "workspace:*",
    "picomatch": "4.0.7",
    "ts-morph": "28.0.0"
  }
}
