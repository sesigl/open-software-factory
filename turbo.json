{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["biome.json", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!system-tests/**", "!features/**"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#lint": {
      "inputs": ["biome.json", "package.json", "turbo.json", "tsconfig.base.json", "*.json"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["build", "^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "check": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:system": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH", "KUBECONFIG", "OSF_SANDBOX_HOST_ALIASES"]
    },
    "docs": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["README.md"]
    },
    "test:paid": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "passThroughEnv": ["OPENROUTER_API_KEY", "OPENAI_MODEL", "CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_MODEL"]
    },
    "mutation": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "passThroughEnv": ["OSF_BASE", "PLAYWRIGHT_BROWSERS_PATH", "KUBECONFIG", "OSF_SANDBOX_HOST_ALIASES"]
    }
  }
}
