{
  "$schema": "https://turborepo.com/schema.json",
  "cacheDir": ".turbo/cache",
  "globalPassThroughEnv": ["DOCKER_HOST", "TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE", "TESTCONTAINERS_HOST_OVERRIDE"],
  "globalDependencies": [
    "biome.json",
    "tsconfig.base.json",
    "Makefile",
    ".nvmrc",
    "pnpm-workspace.yaml",
    "tools/scaffold/install-tools.ts",
    ".github/workflows/verify.yml",
    ".github/test-suites.yml"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!system-tests/**", "!features/**", "!**/*.md"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#lint": {
      "inputs": ["biome.json", "package.json", "turbo.json", "tsconfig.base.json", "*.json"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["build", "^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "check": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:system": {
      "dependsOn": ["build", "^build"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["reports/**"],
      "env": ["OSF_TEST_RUN"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH", "KUBECONFIG", "OSF_SANDBOX_HOST_ALIASES", "CI"]
    },
    "docs": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["README.md"]
    },
    "test:paid": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "passThroughEnv": ["OPENROUTER_API_KEY", "OPENAI_MODEL", "CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_MODEL"]
    },
    "mutation": {
      "dependsOn": ["^build"],
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tools/package.json",
        "$TURBO_ROOT$/tools/scaffold/mutation.ts",
        "$TURBO_ROOT$/tools/scaffold/mutation-runner.ts",
        "$TURBO_ROOT$/tools/checks/quality.ts",
        "$TURBO_ROOT$/tools/checks/lib/**",
        "$TURBO_ROOT$/.github/actions/**"
      ],
      "passThroughEnv": [
        "OSF_BASE",
        "OSF_MUTATION_RUNS",
        "PLAYWRIGHT_BROWSERS_PATH",
        "KUBECONFIG",
        "OSF_SANDBOX_HOST_ALIASES"
      ]
    }
  }
}
