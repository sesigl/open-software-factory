{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sesigl/open-software-factory/main/contracts/run-record/run-record.schema.json",
  "title": "RunRecord",
  "$comment": "Generated by `pnpm build` in contracts/ from typespec/. Do not edit.",
  "type": "object",
  "properties": {
    "resource": {
      "type": "object",
      "properties": {
        "service.name": {
          "type": "string"
        },
        "osf.run.id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "An identifier chosen by the producer. ULIDs are recommended; consumers treat it as opaque."
        },
        "osf.work_item.id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "An identifier chosen by the producer. ULIDs are recommended; consumers treat it as opaque."
        },
        "osf.factory.version": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$",
          "description": "Commit of the factory definition the run used."
        },
        "osf.stage": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "description": "A lowercase name: letters, digits and hyphens, starting with a letter. Agents, stages, adapters, sources."
        },
        "osf.requester.kind": {
          "type": "string",
          "enum": [
            "person",
            "trigger"
          ],
          "description": "Who caused something: a person, or an automated trigger such as a cron rule or an alert."
        },
        "osf.requester.id": {
          "type": "string"
        },
        "osf.source": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "description": "Where the run was started from, for example \"slack\", \"github\", \"cli\"."
        },
        "osf.origin.url": {
          "type": "string",
          "format": "uri"
        },
        "osf.harness.name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "description": "Harness adapter, for example \"claude-code\"."
        },
        "osf.harness.version": {
          "type": "string"
        }
      },
      "required": [
        "service.name",
        "osf.run.id",
        "osf.work_item.id",
        "osf.factory.version",
        "osf.requester.kind",
        "osf.requester.id",
        "osf.source",
        "osf.harness.name"
      ],
      "description": "Set at launch through OTEL_RESOURCE_ATTRIBUTES, so it is on every span of the run."
    },
    "span": {
      "type": "object",
      "properties": {
        "gen_ai.operation.name": {
          "type": "string",
          "const": "invoke_agent"
        },
        "gen_ai.provider.name": {
          "type": "string"
        },
        "gen_ai.agent.name": {
          "type": "string"
        },
        "gen_ai.conversation.id": {
          "type": "string",
          "description": "The harness session ID."
        },
        "gen_ai.request.model": {
          "type": "string"
        },
        "gen_ai.response.model": {
          "type": "string"
        },
        "gen_ai.usage.input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "gen_ai.usage.output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "gen_ai.usage.cache_read.input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "gen_ai.usage.cache_write.input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "osf.outcome": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed",
            "cancelled"
          ],
          "description": "How a run ended."
        },
        "osf.cost.usd": {
          "type": "number",
          "minimum": 0,
          "description": "Cost of all model calls of the run, from the inference gateway."
        },
        "osf.transcript.uri": {
          "type": "string",
          "format": "uri",
          "description": "Full transcript, stored when the run ends."
        },
        "osf.artifact.uris": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "description": "Artifacts of the run: reports, screenshots, videos."
        },
        "osf.pull_request.urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "osf.issue.urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "osf.evidence_bundle.uri": {
          "type": "string",
          "format": "uri"
        },
        "osf.agent_trace.uri": {
          "type": "string",
          "format": "uri",
          "description": "Agent Trace record with line attribution of the run's changes."
        }
      },
      "required": [
        "gen_ai.operation.name",
        "osf.outcome"
      ],
      "description": "Attributes of the root span of the run. GenAI names where a convention exists."
    }
  },
  "required": [
    "resource",
    "span"
  ],
  "description": "The attributes of one run: the OTel resource of every span of the run, and the attributes of its root\n`invoke_agent` span. The run record travels as OTLP; this schema fixes the attribute names and types.\nRealizes SCN-FACTORY-DATA-001 (record shape) and SCN-FACTORY-RUNTIME-008 (attribution)."
}
