{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sesigl/open-software-factory/main/contracts/factory-definition/factory-definition.schema.json",
  "title": "FactoryDefinition",
  "$comment": "Generated by `pnpm build` in contracts/ from typespec/. Do not edit.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editors may point at this schema. Ignored by every tool."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "Version of this format. A new major version of the format gets a new value.",
      "const": 1
    },
    "factory": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "description": "Name of the factory."
    },
    "description": {
      "type": "string"
    },
    "providers": {
      "type": "object",
      "properties": {
        "harness": {
          "type": "object",
          "properties": {},
          "unevaluatedProperties": {
            "type": "string",
            "minLength": 1,
            "description": "A semver range of an adapter, for example \"^2\"."
          }
        },
        "sandbox": {
          "type": "object",
          "properties": {},
          "unevaluatedProperties": {
            "type": "string",
            "minLength": 1,
            "description": "A semver range of an adapter, for example \"^2\"."
          }
        },
        "channel": {
          "type": "object",
          "properties": {},
          "unevaluatedProperties": {
            "type": "string",
            "minLength": 1,
            "description": "A semver range of an adapter, for example \"^2\"."
          }
        },
        "tracker": {
          "type": "object",
          "properties": {},
          "unevaluatedProperties": {
            "type": "string",
            "minLength": 1,
            "description": "A semver range of an adapter, for example \"^2\"."
          }
        },
        "forge": {
          "type": "object",
          "properties": {},
          "unevaluatedProperties": {
            "type": "string",
            "minLength": 1,
            "description": "A semver range of an adapter, for example \"^2\"."
          }
        },
        "inference": {
          "type": "object",
          "properties": {},
          "unevaluatedProperties": {
            "type": "string",
            "minLength": 1,
            "description": "A semver range of an adapter, for example \"^2\"."
          }
        },
        "secrets": {
          "type": "object",
          "properties": {},
          "unevaluatedProperties": {
            "type": "string",
            "minLength": 1,
            "description": "A semver range of an adapter, for example \"^2\"."
          }
        },
        "telemetry": {
          "type": "object",
          "properties": {},
          "unevaluatedProperties": {
            "type": "string",
            "minLength": 1,
            "description": "A semver range of an adapter, for example \"^2\"."
          }
        },
        "policy": {
          "type": "object",
          "properties": {},
          "unevaluatedProperties": {
            "type": "string",
            "minLength": 1,
            "description": "A semver range of an adapter, for example \"^2\"."
          }
        }
      },
      "description": "Adapters per port with a version range, pinned in `factory.lock` by `factory plan`.",
      "additionalProperties": false
    },
    "agents": {
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "harness": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$",
            "description": "Harness adapter, declared under `providers.harness`, for example \"claude-code\"."
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "description": "A model ID or a routing alias of the inference gateway, for example \"routes/triage\"."
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "description": "Path to the Markdown prompt."
          },
          "repositories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Repositories the agent operates on, as clone URLs or \"<owner>/<name>\"."
          },
          "mcp": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "MCP servers: `registry:<name>@<version>` or `<name>@<version>`."
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Paths to skill folders."
          },
          "secrets": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ref:[a-z][a-z0-9-]*/[A-Za-z0-9_./-]+$",
              "description": "A reference to a secret, resolved at the egress proxy, never in the sandbox: \"ref:<provider>/<name>\"."
            }
          },
          "sandbox": {
            "type": "object",
            "properties": {
              "template": {
                "type": "string",
                "minLength": 1,
                "description": "Sandbox template name, for example \"node-24\"."
              },
              "cpu": {
                "type": "number",
                "minimum": 0.001,
                "description": "CPU cores. The smallest unit is 0.001 (one millicore)."
              },
              "memory": {
                "type": "string",
                "pattern": "^[0-9]+(Ki|Mi|Gi|Ti)?$",
                "description": "Kubernetes quantity, for example \"8Gi\"."
              },
              "egress": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Hostnames the sandbox may reach. Everything else is blocked."
              }
            },
            "required": [
              "template"
            ],
            "additionalProperties": false,
            "description": "Runtime of the agent."
          }
        },
        "required": [
          "harness",
          "model",
          "prompt"
        ],
        "additionalProperties": false
      },
      "minProperties": 1,
      "description": "Agents by name."
    },
    "workflow": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$",
            "description": "A lowercase name: letters, digits and hyphens, starting with a letter. Agents, stages, adapters, sources."
          },
          "agent": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$",
            "description": "Agent that runs the stage. Defaults to the agent with the stage's name."
          },
          "gate": {
            "type": "object",
            "properties": {
              "policy": {
                "type": "string",
                "minLength": 1,
                "description": "Path to the Rego policy that decides or picks the approvers."
              },
              "approvers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,62}$",
                  "description": "A lowercase name: letters, digits and hyphens, starting with a letter. Agents, stages, adapters, sources."
                },
                "description": "Approver groups. The policy may narrow them."
              }
            },
            "required": [
              "policy"
            ],
            "additionalProperties": false,
            "description": "The stage waits for a decision before it starts."
          },
          "evidence": {
            "type": "string",
            "enum": [
              "required",
              "optional"
            ],
            "description": "Whether the stage must produce an evidence bundle."
          }
        },
        "required": [
          "stage"
        ],
        "additionalProperties": false
      },
      "description": "Stages in order. Each stage runs one agent; the agent defaults to the stage name."
    },
    "automations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "on": {
            "type": "string",
            "minLength": 1,
            "description": "Event filter, for example \"github.issue.labeled(auto-implement)\" or \"sentry.fatal\"."
          },
          "cron": {
            "type": "string",
            "minLength": 1,
            "description": "Five-field cron expression in UTC."
          },
          "run": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$",
            "description": "Job to run. Required with `cron`; without it an event starts the workflow."
          }
        },
        "description": "Starts the workflow, or the named job, on an event (`on`) or a schedule (`cron`). Exactly one of the two; a\nschedule names its job. One model rather than a union, so every generated client reads it without guessing.",
        "oneOf": [
          {
            "required": [
              "on"
            ],
            "not": {
              "required": [
                "cron"
              ]
            }
          },
          {
            "required": [
              "cron",
              "run"
            ],
            "not": {
              "required": [
                "on"
              ]
            }
          }
        ],
        "additionalProperties": false
      },
      "description": "What starts work without a person asking."
    },
    "scorers": {
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {
        "type": "object",
        "properties": {
          "judge": {
            "type": "string",
            "minLength": 1,
            "description": "Path to the Markdown judge prompt."
          },
          "sample": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Share of runs to score, 0 to 1. Default 1."
          }
        },
        "required": [
          "judge"
        ],
        "additionalProperties": false
      },
      "description": "Scorers by name."
    },
    "benchmarks": {
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {
        "type": "object",
        "properties": {
          "suite": {
            "type": "string",
            "minLength": 1,
            "description": "Path to the Harbor task suite."
          },
          "schedule": {
            "type": "string",
            "description": "Five-field cron expression in UTC. Without it the suite runs on request."
          }
        },
        "required": [
          "suite"
        ],
        "additionalProperties": false
      },
      "description": "Benchmark suites by name."
    }
  },
  "required": [
    "version",
    "factory",
    "agents"
  ],
  "description": "`factory.yaml`: the desired state of one factory (P3). Paths are relative to the file.\nRealizes SCN-FACTORY-CODE-001: agents and prompts; MCP servers, skills and secrets per agent;\nrepositories; model and runtime; automations; scorers and benchmarks.",
  "additionalProperties": false
}
