{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sesigl/open-software-factory/main/contracts/evidence-bundle/evidence-bundle.schema.json",
  "title": "EvidenceManifest",
  "$comment": "Generated by `pnpm build` in contracts/ from typespec/. Do not edit.",
  "type": "object",
  "properties": {
    "manifestVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "Version of this format.",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "An identifier chosen by the producer. ULIDs are recommended; consumers treat it as opaque."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$",
          "description": "A Git commit hash, abbreviated (7+) or full. The factory version is the commit of the factory definition."
        },
        "pullRequest": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "repository",
        "commit"
      ],
      "description": "The change that was verified."
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "An identifier chosen by the producer. ULIDs are recommended; consumers treat it as opaque."
    },
    "workItemId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "An identifier chosen by the producer. ULIDs are recommended; consumers treat it as opaque."
    },
    "producer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "description": "The tool that wrote the bundle, for example proof 1.2.0."
    },
    "result": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ],
      "description": "Passed only when every scenario passed."
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SCN-[A-Z][A-Z0-9]*(-[A-Z][A-Z0-9]*)*-[0-9]{3}$",
            "description": "A scenario ID as checked by SPEC, for example SCN-PROOF-004."
          },
          "result": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped"
            ]
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$",
              "description": "A path inside the bundle: relative, forward slashes, no \"..\"."
            },
            "description": "Paths of the artifacts in this bundle that prove the scenario."
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "result",
          "artifacts"
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$",
            "description": "A path inside the bundle: relative, forward slashes, no \"..\"."
          },
          "kind": {
            "type": "string",
            "enum": [
              "screenshot",
              "video",
              "playwright-trace",
              "junit",
              "log",
              "report",
              "other"
            ]
          },
          "mediaType": {
            "type": "string",
            "minLength": 1,
            "description": "IANA media type, for example \"image/png\"."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "kind",
          "mediaType",
          "sha256"
        ]
      }
    }
  },
  "required": [
    "manifestVersion",
    "id",
    "createdAt",
    "subject",
    "producer",
    "result",
    "scenarios",
    "artifacts"
  ],
  "description": "`evidence.json` at the root of an evidence bundle: what was verified, against which scenario IDs, with which\nartifacts and result (P10)."
}
