{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sesigl/open-software-factory/main/contracts/gate-record/gate-record.schema.json",
  "title": "GateRecord",
  "$comment": "Generated by `pnpm build` in contracts/ from typespec/. Do not edit.",
  "type": "object",
  "properties": {
    "gate": {
      "type": "string",
      "pattern": "^g[0-9a-f]{16}$"
    },
    "workItem": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "description": "A lowercase name: letters, digits and hyphens, starting with a letter. Agents, stages, adapters, sources."
    },
    "summary": {
      "type": "string"
    },
    "request": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 of the canonical request: what was approved."
    },
    "policy": {
      "type": "string",
      "minLength": 1,
      "description": "The policy file."
    },
    "policyDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 of the policy's text: the rules that picked the approvers."
    },
    "risk": {
      "type": "string"
    },
    "approvers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,62}$",
        "description": "A lowercase name: letters, digits and hyphens, starting with a letter. Agents, stages, adapters, sources."
      }
    },
    "channel": {
      "type": "string"
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "rejected",
        "expired"
      ]
    },
    "decidedBy": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "person",
            "trigger"
          ],
          "description": "Who caused something: a person, or an automated trigger such as a cron rule or an alert."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ID in the source system, prefixed with the source, for example \"slack:U024BE7LH\"."
        },
        "displayName": {
          "type": "string",
          "description": "Shown to people, for example \"Varun\"."
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "description": "Who decided. Absent only when the gate expired. A policy that names no group decides as a trigger."
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "description": "The reason of a rejection."
    },
    "signature": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "Ed25519"
        },
        "key": {
          "type": "string",
          "pattern": "^sha256:",
          "description": "SHA-256 of the public key in DER, like \"sha256:…\"."
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "description": "The signature in base64."
        }
      },
      "required": [
        "algorithm",
        "key",
        "value"
      ],
      "description": "Ed25519 over the canonical JSON of the rest of the record. Absent when the record is unsigned."
    }
  },
  "required": [
    "gate",
    "workItem",
    "stage",
    "summary",
    "request",
    "policy",
    "policyDigest",
    "approvers",
    "channel",
    "requestedAt",
    "decision",
    "decidedAt"
  ],
  "description": "gatekeeper: who decided what and when, signed with Ed25519 (ADR 0047)."
}
