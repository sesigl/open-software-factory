{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sesigl/open-software-factory/main/contracts/events/pr-reviewed/pr-reviewed.schema.json",
  "title": "PrReviewed",
  "$comment": "Generated by `pnpm build` in contracts/ from typespec/. Do not edit.",
  "type": "object",
  "properties": {
    "specversion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Unique per source. A consumer that sees the same source and id twice handles the event once."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "The producing module, for example \"/osf/intake\"."
    },
    "type": {
      "type": "string",
      "const": "pr.reviewed@v1"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "string",
      "description": "The ID of the thing the event is about: work item, gate, run, score or pull request."
    },
    "datacontenttype": {
      "type": "string",
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "format": "uri"
    },
    "traceparent": {
      "type": "string",
      "description": "W3C trace context (CloudEvents distributed tracing extension)."
    },
    "data": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "The pull request."
        },
        "reviewer": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "person",
                "trigger"
              ],
              "description": "Who caused something: a person, or an automated trigger such as a cron rule or an alert."
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Stable ID in the source system, prefixed with the source, for example \"slack:U024BE7LH\"."
            },
            "displayName": {
              "type": "string",
              "description": "Shown to people, for example \"Varun\"."
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "description": "A person or trigger. RUNTIME-008: every run is attributed to one."
        },
        "automated": {
          "type": "boolean",
          "description": "True when an agent or a bot wrote the review, not a person."
        },
        "state": {
          "type": "string",
          "enum": [
            "approved",
            "changes_requested",
            "commented"
          ]
        }
      },
      "required": [
        "url",
        "reviewer",
        "state"
      ]
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "data"
  ],
  "description": "forge adapters: a person, an agent or a bot reviewed or commented on a pull request."
}
