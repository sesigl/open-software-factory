{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sesigl/open-software-factory/main/contracts/events/score-recorded/score-recorded.schema.json",
  "title": "ScoreRecorded",
  "$comment": "Generated by `pnpm build` in contracts/ from typespec/. Do not edit.",
  "type": "object",
  "properties": {
    "specversion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Unique per source. A consumer that sees the same source and id twice handles the event once."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "The producing module, for example \"/osf/intake\"."
    },
    "type": {
      "type": "string",
      "const": "score.recorded@v1"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "string",
      "description": "The ID of the thing the event is about: work item, gate, run, score or pull request."
    },
    "datacontenttype": {
      "type": "string",
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "format": "uri"
    },
    "traceparent": {
      "type": "string",
      "description": "W3C trace context (CloudEvents distributed tracing extension)."
    },
    "data": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "An identifier chosen by the producer. ULIDs are recommended; consumers treat it as opaque."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Scorer name, for example \"redundant-tests\"."
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "description": "A number for NUMERIC, 0 or 1 for BOOLEAN, a string for CATEGORICAL."
        },
        "dataType": {
          "type": "string",
          "enum": [
            "NUMERIC",
            "BOOLEAN",
            "CATEGORICAL"
          ]
        },
        "traceId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "description": "Trace of the run (the OTel trace ID)."
        },
        "observationId": {
          "type": "string",
          "description": "Span the score is about, when it is not the whole run."
        },
        "sessionId": {
          "type": "string"
        },
        "comment": {
          "type": "string",
          "description": "The reason."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "enum": [
            "API",
            "ANNOTATION"
          ],
          "description": "API for scorers, ANNOTATION for scores a person reviews."
        },
        "configId": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "properties": {
            "osf.run.id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "An identifier chosen by the producer. ULIDs are recommended; consumers treat it as opaque."
            },
            "osf.scorer.version": {
              "type": "string"
            },
            "osf.judge.model": {
              "type": "string",
              "description": "Judge model of an LLM scorer."
            },
            "osf.judge.cost.usd": {
              "type": "number",
              "minimum": 0,
              "description": "Cost of the judge call."
            }
          },
          "required": [
            "osf.run.id"
          ],
          "unevaluatedProperties": {}
        }
      },
      "required": [
        "id",
        "name",
        "value",
        "dataType",
        "traceId",
        "timestamp",
        "metadata"
      ],
      "description": "The result of one scorer on one run. The fields are a subset of Langfuse's create-score request\n(POST /api/public/scores), so a score can be sent to Langfuse as is. Factory fields live in `metadata`."
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "data"
  ],
  "description": "scorekit: a scorer scored a run."
}
