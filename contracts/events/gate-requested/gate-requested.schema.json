{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sesigl/open-software-factory/main/contracts/events/gate-requested/gate-requested.schema.json",
  "title": "GateRequested",
  "$comment": "Generated by `pnpm build` in contracts/ from typespec/. Do not edit.",
  "type": "object",
  "properties": {
    "specversion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Unique per source. A consumer that sees the same source and id twice handles the event once."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "The producing module, for example \"/osf/intake\"."
    },
    "type": {
      "type": "string",
      "const": "gate.requested@v1"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "string",
      "description": "The ID of the thing the event is about: work item, gate, run, score or pull request."
    },
    "datacontenttype": {
      "type": "string",
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "format": "uri"
    },
    "traceparent": {
      "type": "string",
      "description": "W3C trace context (CloudEvents distributed tracing extension)."
    },
    "data": {
      "type": "object",
      "properties": {
        "gateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "An identifier chosen by the producer. ULIDs are recommended; consumers treat it as opaque."
        },
        "workItemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "An identifier chosen by the producer. ULIDs are recommended; consumers treat it as opaque."
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "An identifier chosen by the producer. ULIDs are recommended; consumers treat it as opaque."
        },
        "stage": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "description": "The stage that waits."
        },
        "policy": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the policy in the factory definition."
        },
        "approvers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$",
            "description": "A lowercase name: letters, digits and hyphens, starting with a letter. Agents, stages, adapters, sources."
          },
          "minItems": 1,
          "description": "Approver groups picked by the policy."
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "What the approver is asked to decide, shown in the channel."
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "url"
            ]
          }
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "gateId",
        "workItemId",
        "stage",
        "policy",
        "approvers",
        "summary"
      ]
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "data"
  ],
  "description": "gatekeeper: a decision is needed before a stage starts."
}
