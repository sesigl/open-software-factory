{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sesigl/open-software-factory/main/contracts/events/pr-opened/pr-opened.schema.json",
  "title": "PrOpened",
  "$comment": "Generated by `pnpm build` in contracts/ from typespec/. Do not edit.",
  "type": "object",
  "properties": {
    "specversion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Unique per source. A consumer that sees the same source and id twice handles the event once."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "The producing module, for example \"/osf/intake\"."
    },
    "type": {
      "type": "string",
      "const": "pr.opened@v1"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "string",
      "description": "The ID of the thing the event is about: work item, gate, run, score or pull request."
    },
    "datacontenttype": {
      "type": "string",
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "format": "uri"
    },
    "traceparent": {
      "type": "string",
      "description": "W3C trace context (CloudEvents distributed tracing extension)."
    },
    "data": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "headBranch": {
          "type": "string"
        },
        "baseBranch": {
          "type": "string"
        },
        "headCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$",
          "description": "A Git commit hash, abbreviated (7+) or full. The factory version is the commit of the factory definition."
        },
        "author": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "person",
                "trigger"
              ],
              "description": "Who caused something: a person, or an automated trigger such as a cron rule or an alert."
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Stable ID in the source system, prefixed with the source, for example \"slack:U024BE7LH\"."
            },
            "displayName": {
              "type": "string",
              "description": "Shown to people, for example \"Varun\"."
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "description": "A person or trigger. RUNTIME-008: every run is attributed to one."
        },
        "workItemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "An identifier chosen by the producer. ULIDs are recommended; consumers treat it as opaque."
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "An identifier chosen by the producer. ULIDs are recommended; consumers treat it as opaque."
        }
      },
      "required": [
        "url",
        "repository",
        "number",
        "title",
        "headBranch",
        "baseBranch",
        "headCommit",
        "author"
      ]
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "data"
  ],
  "description": "forge adapters: the factory opened a pull request."
}
