{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sesigl/open-software-factory/main/contracts/events/issue-labeled/issue-labeled.schema.json",
  "title": "IssueLabeled",
  "$comment": "Generated by `pnpm build` in contracts/ from typespec/. Do not edit.",
  "type": "object",
  "properties": {
    "specversion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Unique per source. A consumer that sees the same source and id twice handles the event once."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "The producing module, for example \"/osf/intake\"."
    },
    "type": {
      "type": "string",
      "const": "issue.labeled@v1"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "string",
      "description": "The ID of the thing the event is about: work item, gate, run, score or pull request."
    },
    "datacontenttype": {
      "type": "string",
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "format": "uri"
    },
    "traceparent": {
      "type": "string",
      "description": "W3C trace context (CloudEvents distributed tracing extension)."
    },
    "data": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "The issue."
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string"
        },
        "author": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "person",
                "trigger"
              ],
              "description": "Who caused something: a person, or an automated trigger such as a cron rule or an alert."
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Stable ID in the source system, prefixed with the source, for example \"slack:U024BE7LH\"."
            },
            "displayName": {
              "type": "string",
              "description": "Shown to people, for example \"Varun\"."
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "description": "The person who opened the issue."
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Every label of the issue after the change."
        },
        "label": {
          "type": "string",
          "description": "The label that was added, when the forge names it."
        }
      },
      "required": [
        "url",
        "repository",
        "number",
        "title",
        "author",
        "labels"
      ]
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "data"
  ],
  "description": "forge adapters: a label was added to an issue."
}
