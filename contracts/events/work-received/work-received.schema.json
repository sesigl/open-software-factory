{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sesigl/open-software-factory/main/contracts/events/work-received/work-received.schema.json",
  "title": "WorkReceived",
  "$comment": "Generated by `pnpm build` in contracts/ from typespec/. Do not edit.",
  "type": "object",
  "properties": {
    "specversion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Unique per source. A consumer that sees the same source and id twice handles the event once."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "The producing module, for example \"/osf/intake\"."
    },
    "type": {
      "type": "string",
      "const": "work.received@v1"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "string",
      "description": "The ID of the thing the event is about: work item, gate, run, score or pull request."
    },
    "datacontenttype": {
      "type": "string",
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "format": "uri"
    },
    "traceparent": {
      "type": "string",
      "description": "W3C trace context (CloudEvents distributed tracing extension)."
    },
    "data": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "An identifier chosen by the producer. ULIDs are recommended; consumers treat it as opaque."
        },
        "type": {
          "type": "string",
          "enum": [
            "idea",
            "bug",
            "task",
            "automation"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "description": {
          "type": "string"
        },
        "requester": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "person",
                "trigger"
              ],
              "description": "Who caused something: a person, or an automated trigger such as a cron rule or an alert."
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Stable ID in the source system, prefixed with the source, for example \"slack:U024BE7LH\"."
            },
            "displayName": {
              "type": "string",
              "description": "Shown to people, for example \"Varun\"."
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "description": "The person or trigger that asked for the work."
        },
        "origin": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}$",
              "description": "The channel or system, for example \"slack\", \"github\", \"sentry\", \"cron\", \"mcp\"."
            },
            "url": {
              "type": "string",
              "format": "uri",
              "description": "Link back to the origin, for example the Slack thread. Absent for a schedule."
            },
            "externalId": {
              "type": "string",
              "description": "ID in the source system."
            }
          },
          "required": [
            "source"
          ],
          "description": "Where the work came from."
        },
        "dedupeKey": {
          "type": "string",
          "minLength": 1,
          "description": "Requests with the same key become one work item, for example \"github:acme/web#42\"."
        },
        "surface": {
          "type": "string",
          "description": "Product surface the work is about, for example \"checkout\"."
        },
        "priority": {
          "type": "string",
          "enum": [
            "urgent",
            "high",
            "normal",
            "low"
          ],
          "description": "Set by triage."
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "url"
            ]
          },
          "description": "Related material: an error report, a change, a document."
        }
      },
      "required": [
        "id",
        "type",
        "title",
        "requester",
        "origin",
        "dedupeKey"
      ],
      "description": "One unit of requested work: the `data` of a `work.received@v1` CloudEvent."
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "data"
  ],
  "description": "intake: a work item was accepted."
}
