{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sesigl/open-software-factory/main/contracts/factory-lock/factory-lock.schema.json",
  "title": "FactoryLock",
  "$comment": "Generated by `pnpm build` in contracts/ from typespec/. Do not edit.",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1,
      "description": "The version of the lock's format."
    },
    "mcp": {
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "package": {
            "type": "object",
            "properties": {
              "registryType": {
                "type": "string",
                "const": "npm"
              },
              "identifier": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "registryType",
              "identifier",
              "version"
            ]
          },
          "remote": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "type",
              "url"
            ]
          }
        },
        "required": [
          "name",
          "version"
        ],
        "description": "One registry MCP server at its exact version, with the npm package or the remote it starts."
      },
      "description": "The registry MCP servers, by their reference in factory.yaml, for example `registry:io.github.acme/tracker@1.4`."
    },
    "adapters": {
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {
        "type": "object",
        "properties": {},
        "unevaluatedProperties": {
          "type": "object",
          "properties": {
            "range": {
              "type": "string",
              "minLength": 1,
              "description": "The range under `providers` that the pin was resolved from, for example \"^2\"."
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "description": "The exact version, for example \"2.3.1\"."
            }
          },
          "required": [
            "range",
            "version"
          ],
          "description": "One adapter's npm package `@opensoftware/<port>-<name>` at the newest version inside its range.",
          "additionalProperties": false
        }
      },
      "description": "The adapters under `providers` that `factory plan --adapters` pinned, per port and adapter name (ADR 0125). A pin\ncounts only while its `range` is the range factory.yaml declares."
    }
  },
  "required": [
    "version",
    "mcp"
  ],
  "description": "factory.lock next to factory.yaml (ADR 0020, ADR 0125): the exact versions that `factory plan` pinned. factory-spec\nwrites it; the foreman reads the pins of its adapters."
}
