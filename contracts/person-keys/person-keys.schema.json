{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sesigl/open-software-factory/main/contracts/person-keys/person-keys.schema.json",
  "title": "PersonKeys",
  "$comment": "Generated by `pnpm build` in contracts/ from typespec/. Do not edit.",
  "type": "object",
  "properties": {
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kty": {
            "type": "string",
            "const": "OKP"
          },
          "crv": {
            "type": "string",
            "const": "Ed25519"
          },
          "alg": {
            "type": "string",
            "const": "Ed25519"
          },
          "use": {
            "type": "string",
            "const": "sig"
          },
          "kid": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "description": "The key's JWK thumbprint (RFC 7638) with SHA-256; a proof names it in its `kid`."
          },
          "x": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "description": "The public key."
          }
        },
        "required": [
          "kty",
          "crv",
          "alg",
          "use",
          "kid",
          "x"
        ],
        "description": "One Ed25519 public key. Closed: a key with its private part `d` or any other member is invalid.",
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "keys"
  ],
  "description": "The public keys of an issuer of person proofs (ADR 0151): a JSON Web Key Set (RFC 7517), as the console publishes it\nat `/.well-known/jwks.json`. The first key of the issuer's setting signs; every key here verifies.",
  "additionalProperties": false
}
