{
  "name": "@opensoftware/ui",
  "version": "0.0.0",
  "private": true,
  "description": "The design system of the open software factory's UI: tokens for a dark and a light theme, the brand, and the components of its pages.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sesigl/open-software-factory.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./assets/tokens.css",
    "./brand/*": "./assets/brand/*"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:system": "testkit timed vitest run",
    "mutation": "node ../../tools/bin/osf.ts mutation ."
  },
  "devDependencies": {
    "@opensoftware/testkit": "workspace:*"
  }
}
