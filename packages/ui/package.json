{
  "name": "@opensoftware/ui",
  "version": "0.0.0",
  "private": true,
  "description": "The design system of the open software factory's UI: tokens for a dark and a light theme, the brand, and the components of its pages.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sesigl/open-software-factory.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./assets/tokens.css",
    "./brand/*": "./assets/brand/*",
    "./components/*": "./src/components/*",
    "./styles/*": "./src/styles/*"
  },
  "files": [
    "dist",
    "assets",
    "src/components",
    "src/styles"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && astro build",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:system": "testkit timed vitest run",
    "mutation": "node ../../tools/bin/osf.ts mutation ."
  },
  "devDependencies": {
    "@opensoftware/testkit": "workspace:*",
    "astro": "7.4.4",
    "vite-plugin-solid": "2.11.15"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "solid-js": "1.9.18"
  }
}
