---
// The work list that becomes empty: every 10 seconds the island loads a route that answers no work item.
import Page from "../../../src/components/Page.astro";
import WorkList from "../../../src/components/WorkList.astro";
import { workList } from "../../work-list.ts";
---
<Page title="Work list that becomes empty" theme="dark">
  <main>
    <h1>Work list that becomes empty</h1>
    <WorkList list={workList("/work-list/empty.json", 10_000)} />
  </main>
</Page>
