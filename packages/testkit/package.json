{
  "name": "@opensoftware/testkit",
  "version": "0.36.0",
  "description": "The only way system tests touch a module: scenario(), the sut handle, fakes and the testkit CLI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sesigl/open-software-factory.git",
    "directory": "packages/testkit"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./readme": "./src/support/readme.ts",
    "./harness-agent": "./src/fakes/harness-agent-file.ts"
  },
  "bin": {
    "testkit": "bin/testkit.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./readme": {
        "types": "./dist/src/support/readme.d.ts",
        "default": "./dist/src/support/readme.js"
      },
      "./harness-agent": {
        "types": "./dist/src/fakes/harness-agent-file.d.ts",
        "default": "./dist/src/fakes/harness-agent-file.js"
      }
    },
    "bin": {
      "testkit": "dist/bin/testkit.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:system": "node bin/testkit.ts timed vitest run"
  },
  "peerDependencies": {
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.9.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@nats-io/transport-node": "3.4.0",
    "@testing-library/dom": "10.4.2",
    "axe-core": "4.14.0",
    "dom-accessibility-api": "0.5.16",
    "happy-dom": "21.0.4",
    "openapi-fetch": "0.17.0",
    "playwright-core": "1.56.1",
    "testcontainers": "12.2.0",
    "yaml": "2.9.1"
  }
}
