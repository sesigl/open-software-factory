{
  "name": "@opensoftware/testkit",
  "version": "0.23.0",
  "description": "The only way system tests touch a module: scenario(), the sut handle, fakes and the testkit CLI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sesigl/open-software-factory.git",
    "directory": "packages/testkit"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./readme": "./src/support/readme.ts"
  },
  "bin": {
    "testkit": "bin/testkit.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./readme": {
        "types": "./dist/src/support/readme.d.ts",
        "default": "./dist/src/support/readme.js"
      }
    },
    "bin": {
      "testkit": "dist/bin/testkit.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:system": "vitest run"
  },
  "peerDependencies": {
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.9.0",
    "@electric-sql/pglite": "0.5.11",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@nats-io/transport-node": "3.4.0",
    "openapi-fetch": "0.17.0",
    "testcontainers": "12.2.0",
    "yaml": "2.9.1"
  }
}
