{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "sourceMap": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": ["bin/**/*.ts", "src/**/*.ts", "src/**/*.js"]
}
