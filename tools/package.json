{
  "name": "@opensoftware/tools",
  "version": "0.0.0",
  "private": true,
  "description": "Repository tooling and the deterministic checks of docs/quality/checks.md.",
  "type": "module",
  "bin": {
    "osf": "bin/osf.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "node bin/osf.ts check",
    "test:system": "vitest run",
    "docs": "node bin/osf.ts docs ."
  },
  "dependencies": {
    "@opensoftware/contracts": "workspace:*",
    "@opensoftware/spec-files": "workspace:*",
    "@opensoftware/testkit": "workspace:*",
    "@stryker-mutator/core": "10.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dependency-cruiser": "18.6.0",
    "jscpd": "5.4.1",
    "picomatch": "4.0.7",
    "ts-morph": "28.0.0",
    "v8-to-istanbul": "9.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/picomatch": "4.0.3"
  }
}
